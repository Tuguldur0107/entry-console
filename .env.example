# entry-console — Entry Accounting-ийн харилцагчийн repo-уудыг удирдах самбар.
# Эх сурвалж = GitHub (DB байхгүй): харилцагч = topic `entry-customer`-тэй repo.

# ── Заавал ──────────────────────────────────────────────────────────────────
# Харилцагчийн бүртгэл (Railway: Entry console DB → Variables → DATABASE_URL reference)
DATABASE_URL=postgresql://user:password@localhost:5432/entry_console
# Console-д нэвтрэх нууц үг (нэг админ) — урт, санамсаргүй
CONSOLE_PASSWORD=change-me
# Session cookie-ийн гарын үсэг — `openssl rand -base64 32`
AUTH_SECRET=change-me
# GitHub PAT: харилцагчийн repo-уудыг унших, workflow dispatch, collaborator
# урих, variable тавих. Classic: repo + workflow (+ admin:org org-д бол);
# core repo-ийн provision-customer.yml-д ашигладаг PROVISION_TOKEN-той ижил байж болно.
GITHUB_TOKEN=ghp_...

# ── Сонголтоор (default-ууд) ────────────────────────────────────────────────
# Харилцагчийн repo-уудын эзэн (хэрэглэгч эсвэл org) ба төрөл
GITHUB_OWNER=Tuguldur0107
GITHUB_OWNER_TYPE=user            # user | org
# Core repo (release, provision workflow энд)
CORE_REPO=Tuguldur0107/entry-accounting

# ── Railway автомат deploy (сонголтоор) ─────────────────────────────────────
# Project горим: харилцагч бүр ЭНЭ project дотор entry-<код> + entry-<код>-db service
# (Railway → project → Settings → Tokens). Environment ID өгөхгүй бол token-ийнхыг авна.
RAILWAY_PROJECT_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
# Account горим (оронд нь): харилцагч бүрд тусдаа project — Account settings → Tokens
# RAILWAY_TOKEN=
# RAILWAY_WORKSPACE_ID=
# Railway-ийн GitHub app харилцагчийн repo эзэн (GITHUB_OWNER) org-д хандах эрхтэй байх ёстой.
