# entry-console — Entry Accounting-ийн харилцагчийн repo-уудыг удирдах самбар.
# Эх сурвалж = GitHub (DB байхгүй): харилцагч = topic `entry-customer`-тэй repo.

# ── Заавал ──────────────────────────────────────────────────────────────────
# Харилцагчийн бүртгэл (Railway: Entry console DB → Variables → DATABASE_URL reference)
DATABASE_URL=postgresql://user:password@localhost:5432/entry_console
# Console-д нэвтрэх нууц үг (нэг админ) — урт, санамсаргүй
CONSOLE_PASSWORD=change-me
# Session cookie-ийн гарын үсэг — `openssl rand -base64 32`
AUTH_SECRET=change-me
# GitHub PAT: харилцагчийн repo-уудыг унших, workflow dispatch, collaborator
# урих, variable тавих. Classic: repo + workflow (+ admin:org org-д бол);
# core repo-ийн provision-customer.yml-д ашигладаг PROVISION_TOKEN-той ижил байж болно.
GITHUB_TOKEN=ghp_...

# ── Сонголтоор (default-ууд) ────────────────────────────────────────────────
# Харилцагчийн repo-уудын эзэн (хэрэглэгч эсвэл org) ба төрөл
GITHUB_OWNER=Tuguldur0107
GITHUB_OWNER_TYPE=user            # user | org
# Core repo (release, provision workflow энд)
CORE_REPO=Tuguldur0107/entry-accounting

# ── Railway автомат deploy (сонголтоор) ─────────────────────────────────────
# Зөвлөмж: RAILWAY_TOKEN (Account settings → Tokens) + RAILWAY_PROJECT_ID —
# харилцагч бүр ЭНЭ project дотор entry-<код> + entry-<код>-db service болж,
# GitHub repo автоматаар холбогдоно. RAILWAY_PROJECT_ID өгөхгүй бол харилцагч
# бүрд тусдаа project үүснэ (RAILWAY_WORKSPACE_ID сонголтоор).
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
# RAILWAY_WORKSPACE_ID=
# Хязгаарлагдмал хувилбар: project token (project → Settings → Tokens) — service, DB,
# domain, variables үүсгэнэ, харин GitHub repo ХОЛБОЖ ЧАДАХГҮЙ (Railway дээр гараар).
# RAILWAY_PROJECT_TOKEN=
# Railway-ийн GitHub app харилцагчийн repo эзэн (GITHUB_OWNER) org-д суусан байх ёстой:
# https://github.com/apps/railway-app/installations/new

# ── Хяналт, мэдэгдэл, domain (сонголтоор) ──────────────────────────────────
# REST + cron нэвтрэлт — Тохиргоо → «Хяналт идэвхжүүлэх» дарахад автоматаар үүснэ
CONSOLE_API_KEY=
# Харилцагч бүрд <код>.<domain> custom domain автоматаар (DNS CNAME-ийг та нэмнэ)
CUSTOMER_BASE_DOMAIN=
# Мэдэгдэл: Telegram bot (@BotFather → token; chat id) ба/эсвэл webhook (Slack/Discord)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
